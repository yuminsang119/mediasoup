# ============================================================
# mediasoup Streaming Server - 환경변수 설정
# 이 파일을 .env로 복사 후 값을 수정하세요
# cp .env.example .env && nano .env
# ============================================================

# ── 네트워크 ──
# 서버 공인 IP (WebRTC ICE candidate + TURN에 사용, 필수)
PUBLIC_IP=203.0.113.100
# 도메인 (HTTPS 인증서 발급용)
DOMAIN=streaming.example.com
# SSL 인증서 발급 이메일
SSL_EMAIL=admin@example.com

# ── TURN/STUN 서버 (coturn) ──
TURN_USERNAME=mediasoup
TURN_PASSWORD=changeme_strong_password_here

# ── 녹화 ──
# 호스트 녹화 저장 경로
RECORDING_PATH=/data/recordings
# 녹화 보관 기간 (시간, 168 = 7일, 0 = 무제한)
RECORDING_RETENTION_HOURS=168

# ── 모니터링 (선택) ──
# docker compose --profile monitoring up -d
GRAFANA_PASSWORD=admin

# ── Docker Compose Profiles ──
# 비워두면 기본 서비스만, monitoring 추가 가능
COMPOSE_PROFILES=
